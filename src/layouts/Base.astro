---
import '../styles/global.css';
import '../styles/cine.css';
import 'katex/dist/katex.min.css';
import { SITE } from '../site';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  /** Izgaralı sayfalar (fotoğraf, kitaplık) için geniş sütun */
  wide?: boolean;
  /** Tam ekran, kaydırmaya bağlı ana sayfa */
  cinematic?: boolean;
}

const { title, description = SITE.description, wide = false, cinematic = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
---

<!doctype html>
<html lang={SITE.lang} data-cine>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050608" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,700..900&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400;1,8..60,600&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />

    {
      cinematic ? (
        <main id="main" class="cine">
          <slot />
        </main>
      ) : (
        <div class="shell">
          <main id="main" class:list={[wide && 'wide']}>
            <slot />
          </main>
          <Footer />
        </div>
      )
    }

    <script>
        import { initMotion, gsap, ScrollTrigger, reduceMotion } from '../scripts/motion';

        // İç sayfalar: aynı yumuşak kaydırma ve sade giriş animasyonları.
        // Ana sayfanın kendi sahneleri var; orada çalışmaz.
        const inner = !document.querySelector('main.cine');
        if (inner) initMotion();

        if (inner && !reduceMotion) {
          // Sayfa başlığı kelime kelime bulanıktan netleşir
          const h1 = document.querySelector<HTMLElement>('main h1');
          if (h1 && !h1.querySelector('*')) {
            const words = h1.textContent!.trim().split(/\s+/);
            h1.textContent = '';
            words.forEach((w, i) => {
              const s = document.createElement('span');
              s.className = 'blur-word';
              s.textContent = w;
              h1.append(s, i < words.length - 1 ? ' ' : '');
            });
            gsap.to(h1.querySelectorAll('.blur-word'), {
              opacity: 1,
              filter: 'blur(0px)',
              y: 0,
              duration: 1.1,
              stagger: 0.07,
              ease: 'power3.out',
            });
          }

          // Liste ve figürler ekrana girerken yukarı süzülür
          const items = document.querySelectorAll<HTMLElement>(
            'main .work, main .entry, main .card, main .prose > *, main .frame, main .book, main [data-bloch], main .ab__photo, main .log li'
          );
          gsap.set(items, { opacity: 0, y: 28, filter: 'blur(6px)' });
          ScrollTrigger.batch(items, {
            start: 'top 92%',
            once: true,
            onEnter: (batch) =>
              gsap.to(batch, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.8, stagger: 0.06, ease: 'power3.out' }),
          });
          addEventListener('load', () => ScrollTrigger.refresh());
        }
      </script>
  </body>
</html>
