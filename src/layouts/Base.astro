---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE, NAV } from '../site';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Izgaralı sayfalar (fotoğraf, kitaplık) için geniş sütun */
  wide?: boolean;
}

const { title, description = SITE.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&display=swap"
    />

    <!-- Kayıtlı tema tercihini boyamadan önce uygula (yanıp sönmeyi önler) -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* localStorage kapalıysa sistem tercihiyle devam */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <header class="masthead">
        <h1 class="masthead__title"><a href="/">{SITE.title}</a></h1>
        <p class="masthead__tag">{SITE.tagline}</p>
      </header>

      <nav class="nav" aria-label="Main navigation">
        {
          NAV.map((item) => {
            const href = item.href.replace(/\/+$/, '') || '/';
            return (
              <a href={item.href} aria-current={path === href ? 'page' : undefined}>
                {item.label}
              </a>
            );
          })
        }

        <button class="theme-toggle" type="button" data-theme-toggle aria-live="polite">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <span data-theme-label>Theme</span>
        </button>
      </nav>

      <main id="main" class:list={[wide && 'wide']}>
        <slot />
      </main>

      <Footer />
    </div>

    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        const label = btn.querySelector('[data-theme-label]');
        const root = document.documentElement;

        const current = () =>
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        const sync = () => {
          const isDark = current() === 'dark';
          label.textContent = isDark ? 'Light' : 'Dark';
          btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        };

        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* kaydedemesek de o anki sayfada çalışır */
          }
          sync();
        });

        sync();
      })();
    </script>
  </body>
</html>
