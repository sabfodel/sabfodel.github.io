---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE, NAV, TICKER } from '../site';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Pass false to drop the sidebar */
  sidebar?: boolean;
}

const { title, description = SITE.description, sidebar = true } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0506" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <!-- Body and label type are system fonts (Georgia / Courier New);
         only the blackletter display face is loaded from outside. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pirata+One&display=swap" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <header class="masthead">
        <figure class="masthead__figure">
          <img src="/img/claymore.png" alt="" width="765" height="782" />
          <figcaption>art: Ripper_92</figcaption>
        </figure>

        <div class="masthead__main">
          <h1 class="masthead__title"><a href="/">{SITE.title}</a></h1>
          <p class="masthead__tag">{SITE.tagline}</p>
          <nav class="nav" aria-label="Main navigation">
            {
              NAV.map((item) => {
                const href = item.href.replace(/\/+$/, '') || '/';
                return (
                  <a href={item.href} aria-current={path === href ? 'page' : undefined}>
                    {item.label}
                  </a>
                );
              })
            }
          </nav>
        </div>
      </header>

      <div class="ticker" aria-hidden="true">
        <div class="ticker__track">
          {TICKER.map((t) => <span set:html={`✝ ${t}`} />)}
          {TICKER.map((t) => <span set:html={`✝ ${t}`} />)}
        </div>
      </div>

      {
        sidebar ? (
          <div class="layout">
            <main id="main">
              <slot />
            </main>
            <Sidebar />
          </div>
        ) : (
          <main id="main">
            <slot />
          </main>
        )
      }

      <Footer />
    </div>
  </body>
</html>
