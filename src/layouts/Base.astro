---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE } from '../site';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  /** Izgaralı sayfalar (fotoğraf, kitaplık) için geniş sütun */
  wide?: boolean;
  /** Tam ekran, her zaman koyu, kaydırmaya bağlı ana sayfa */
  cinematic?: boolean;
}

const { title, description = SITE.description, wide = false, cinematic = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
---

<!doctype html>
<html lang={SITE.lang} data-cine={cinematic ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,700..900&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400;1,8..60,600&display=swap"
    />

    <!-- Kayıtlı tema tercihini boyamadan önce uygula (yanıp sönmeyi önler) -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* localStorage kapalıysa sistem tercihiyle devam */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {
      cinematic ? (
        <>
          <Header float />
          <main id="main" class="cine">
            <slot />
          </main>
        </>
      ) : (
        <div class="shell">
          <Header />
          <main id="main" class:list={[wide && 'wide']}>
            <slot />
          </main>
          <Footer />
        </div>
      )
    }

    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        const root = document.documentElement;

        const current = () =>
          root.dataset.theme ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        const sync = () => {
          const isDark = current() === 'dark';
          btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        };

        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          document.dispatchEvent(new CustomEvent('themechange'));
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* kaydedemesek de o anki sayfada çalışır */
          }
          sync();
        });

        sync();
      })();
    </script>
  </body>
</html>
