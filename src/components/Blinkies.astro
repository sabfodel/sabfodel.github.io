---
// Kenar çubuğundaki 88x31 usulü rozetler. Metinleri istediğin gibi değiştir,
// istediğin kadar ekle/çıkar. variant: '' | blinkie--pink | blinkie--bone | blinkie--void
const blinkies = [
  { text: 'best viewed in the dark', variant: '' },
  { text: 'under construction', variant: 'blinkie--pink' },
  { text: 'no cookies here', variant: 'blinkie--bone' },
  { text: 'turn the lights off', variant: 'blinkie--void' },
];
---

<ul class="blinkies">
  {blinkies.map((b) => <li class={`blinkie ${b.variant}`}>{b.text}</li>)}
</ul>
