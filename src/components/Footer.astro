---
import { SITE } from '../site';
const year = new Date().getFullYear();
// Old-school hit counter — decorative, frozen at build time
const hits = String(31337 + new Date().getDate()).padStart(6, '0').split('');
---

<footer class="foot">
  <svg class="sigil" viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="50" r="46" fill="none" stroke="#e0242c" stroke-width="1.5" />
    <circle cx="50" cy="50" r="34" fill="none" stroke="#6d0d12" stroke-width="1" stroke-dasharray="3 4" />
    <path d="M50 14 L81 68 L19 68 Z" fill="none" stroke="#ece2d2" stroke-width="1.4" />
    <path d="M50 86 L19 32 L81 32 Z" fill="none" stroke="#e0242c" stroke-width="1.2" opacity=".75" />
    <circle cx="50" cy="50" r="4" fill="#e0242c" />
  </svg>

  <div class="counter" title="visitor counter" aria-hidden="true">
    {hits.map((d) => <span>{d}</span>)}
  </div>

  <p style="margin:0">© {year} {SITE.title} — take what's useful, just say where it came from</p>
  <p style="margin:0">
    <a href="/rss.xml">rss</a> · <a href={SITE.github}>github</a> ·
    <a href="/about/">about</a> · <a href={`mailto:${SITE.email}`}>email</a>
  </p>
  <p style="margin:0" class="muted">best viewed at 1024×768 or above, with the lights off</p>
</footer>
