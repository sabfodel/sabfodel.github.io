---
import { SITE, NAV } from '../site';
const year = new Date().getFullYear();
---

<footer class="ft">
  <p class="hud">contact</p>
  <a class="ft__big wide-type" href={SITE.github}>Let’s talk</a>
  <nav class="ft__pills" aria-label="Site">
    <a class="pill" href={SITE.github}>GitHub ↗</a>
    {SITE.linkedin && <a class="pill pill--ghost" href={SITE.linkedin}>LinkedIn ↗</a>}
    {NAV.map((item) => <a class="pill pill--ghost" href={item.href}>{item.label}</a>)}
  </nav>
  <div class="ft__row hud">
    <span>© {year} {SITE.title}</span>
    <a href="/rss.xml">rss</a>
    <a href="#main">back to top ↑</a>
  </div>
</footer>

<style>
  .ft {
    display: grid;
    justify-items: center;
    gap: 1.4rem;
    margin: 8rem calc(50% - 50vw) 0;
    padding: 5rem clamp(1rem, 4vw, 3rem) 1.4rem;
    border-top: 1px solid var(--line);
    background: radial-gradient(50% 60% at 50% 40%, rgba(255, 244, 225, .05), transparent 70%);
    text-align: center;
  }

  .ft > .hud { margin: 0; }

  .ft__big {
    font-size: clamp(3rem, 12vw, 11rem);
    color: var(--ink);
    border: 0;
    white-space: nowrap;
    transition: color .3s ease, letter-spacing .4s ease;
  }

  .ft__big:hover, .ft__big:focus-visible { color: var(--glow-a); letter-spacing: -.005em; }

  .ft__pills { display: flex; flex-wrap: wrap; justify-content: center; gap: .55rem; }

  .ft__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .6rem 1.4rem;
    width: 100%;
    margin-top: 3rem;
  }

  .ft__row a { color: var(--ink-dim); border: 0; }
  .ft__row a:hover { color: var(--ink); }

  @media (max-width: 640px) {
    .ft__row { justify-content: center; }
  }
</style>
