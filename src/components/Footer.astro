---
import { SITE, NAV, OFF_THE_CLOCK } from '../site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div>
    <span class="label">sabfodel / physics</span>
    <p>
      Built with Astro. Equations typeset with KaTeX. No cookies, no tracking.
    </p>
    <p>© {year} {SITE.title} — take what's useful, just say where it came from.</p>
  </div>
  <nav aria-label="Site">
    <span class="label">site</span>
    <ul>
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
  <nav aria-label="Elsewhere">
    <span class="label">elsewhere</span>
    <ul>
      <li><a href={SITE.github}>github</a></li>
      {SITE.linkedin && <li><a href={SITE.linkedin}>linkedin</a></li>}
      <li><a href="/rss.xml">rss</a></li>
    </ul>
    <span class="label" style="display:block;margin-top:1.1rem">off the clock</span>
    <ul>
      {OFF_THE_CLOCK.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
</footer>
