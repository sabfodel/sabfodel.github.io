---
import { SITE, NAV } from '../site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="topbar topbar--float">
  <a class="mark" href="/" aria-label={`${SITE.title} — home`}>
    <canvas class="mark__liquid" data-liquid-logo aria-hidden="true"></canvas>
    <span class="mark__name mark__nerd" data-liquid-fallback>{'\u{F0768}'} {SITE.title}</span>
    <span class="mark__sub label">/ physics</span>
  </a>

  <nav class="nav" aria-label="Main navigation">
    {
      NAV.map((item, i) => {
        const href = item.href.replace(/\/+$/, '') || '/';
        const here = path === href || path.startsWith(href + '/');
        return (
          <a href={item.href} aria-current={here ? 'page' : undefined}>
            <span class="idx">0{i + 1}</span>{item.label}
          </a>
        );
      })
    }
  </nav>
</header>

<style>
  .mark { align-items: center; }

  .mark__nerd {
    font-family: 'BlexMono Nerd', var(--font-mono);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0;
  }

  .mark__liquid { display: none; }
  .mark.is-liquid .mark__liquid { display: block; }
  .mark.is-liquid .mark__nerd { display: none; }
</style>

<script>
  import { mountLiquid, ATOM } from '../scripts/liquid-logo';
  import { SITE } from '../site';

  const mark = document.querySelector<HTMLElement>('.mark')!;
  const canvas = mark.querySelector<HTMLCanvasElement>('[data-liquid-logo]')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  mountLiquid(canvas, { text: `${ATOM} ${SITE.title}`, size: 22, pad: 0.18, still }).then((ok) => {
    if (ok) mark.classList.add('is-liquid');
  });
</script>
