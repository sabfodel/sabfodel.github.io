---
import { SITE, NAV } from '../site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="topbar topbar--float">
  <a class="mark" href="/" aria-label={`${SITE.title} — home`}>
    <span class="mark__name">{SITE.title}</span>
    <span class="mark__sub label">/ physics</span>
  </a>

  <nav class="nav" aria-label="Main navigation">
    {
      NAV.map((item, i) => {
        const href = item.href.replace(/\/+$/, '') || '/';
        const here = path === href || path.startsWith(href + '/');
        return (
          <a href={item.href} aria-current={here ? 'page' : undefined}>
            <span class="idx">0{i + 1}</span>{item.label}
          </a>
        );
      })
    }
  </nav>
</header>
