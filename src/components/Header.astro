---
import { SITE, NAV } from '../site';

interface Props {
  /** Sinematik ana sayfada: sabit, şeffaf, tema düğmesiz */
  float?: boolean;
}

const { float = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class:list={['topbar', float && 'topbar--float']}>
  <a class="mark" href="/" aria-label={`${SITE.title} — home`}>
    <span class="mark__name">{SITE.title}</span>
    <span class="mark__sub label">/ physics</span>
  </a>

  <nav class="nav" aria-label="Main navigation">
    {
      NAV.map((item, i) => {
        const href = item.href.replace(/\/+$/, '') || '/';
        const here = path === href || path.startsWith(href + '/');
        return (
          <a href={item.href} aria-current={here ? 'page' : undefined}>
            <span class="idx">0{i + 1}</span>{item.label}
          </a>
        );
      })
    }
    {!float && (
    <button class="theme-toggle" type="button" data-theme-toggle>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
    )}
  </nav>
</header>
