---
import type { CollectionEntry } from 'astro:content';
import { starParts, STATUS } from '../utils';

interface Props {
  books: CollectionEntry<'reading'>[];
  empty?: string;
}

const { books, empty = 'Nothing on this shelf.' } = Astro.props;
---

{
  books.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="shelf">
      {books.map((b) => {
        const s = starParts(b.data.rating);
        const badge =
          b.data.status === 'reading' || b.data.status === 'done' ? b.data.status : null;
        return (
          <li class="book">
            <a href={`/reading/${b.id}/`}>
              <div class:list={['book__cover', !b.data.cover && 'book__cover--blank']}>
                {b.data.cover ? (
                  <img src={b.data.cover} alt={`Cover of ${b.data.title}`} loading="lazy" />
                ) : (
                  <span>{b.data.title}</span>
                )}
                {badge && (
                  <span class={`book__badge book__badge--${badge}`}>{STATUS[badge]}</span>
                )}
              </div>
              <p class="book__title">{b.data.title}</p>
            </a>
            <p class="book__author">
              {b.data.author}
              {b.data.rating !== undefined && (
                <span class="stars">
                  {' '}
                  {s.on}
                  <span class="off">{s.off}</span>
                </span>
              )}
            </p>
          </li>
        );
      })}
    </ul>
  )
}
