---
/**
 * SELECTED SIMULATIONS — kâğıt zemin üzerinde, silindir yüzeyine sarılmış gibi kıvrılan
 * proje şeridi. Dikey kaydırma şeridi yatay akıtır; her kart merkeze uzaklığına göre
 * Y ekseninde döner ve derinleşir. Arkada akan dev kontur yazı, altta ortadaki projenin
 * bilgileri ve ilerleme çubuğu.
 */
import { getCollection } from 'astro:content';
import { byDateDesc } from '../../utils';

const projects = (await getCollection('projects', (p) => p.data.featured && !!p.data.cover)).sort(
  (a, b) => b.data.order - a.data.order || byDateDesc(a, b)
);

const cards = [
  ...projects.map((p) => ({
    href: `/projects/${p.id}/`,
    img: p.data.cover!,
    alt: p.data.coverAlt ?? '',
    dark: p.data.coverDark,
    title: p.data.title,
    meta: `${p.data.lang} · ${p.data.tags[0]?.replace(/-/g, ' ')}`,
    summary: p.data.summary ?? '',
    result: p.data.result ?? '',
  })),
  {
    href: '/lab/',
    img: '/img/work/bloch.svg',
    alt: 'Bloch sphere with a qubit state vector',
    dark: true,
    title: 'Bloch sphere',
    meta: 'Lab · interactive',
    summary: 'One qubit you can rotate with gates and measure, in the browser.',
    result: 'Every single-qubit gate is a rotation of the Bloch vector.',
  },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="cc pin section--paper" data-cc style={`height:${cards.length * 70 + 100}vh`} aria-labelledby="cc-title">
  <div class="pin__stage cc__stage">
    <p class="cc__bg wide-type" data-cc-bg aria-hidden="true">Simulations · Simulations · Simulations ·</p>

    <header class="cc__head">
      <div>
        <p class="hud">§ 03 — projects</p>
        <p class="cc__count wide-type" aria-hidden="true"><span data-cc-n>01</span><small> / {pad(cards.length)}</small></p>
      </div>
      <h2 id="cc-title" class="cc__h wide-type">Selected<br />simulations</h2>
    </header>

    <div class="cc__viewport">
      <ul class="cc__track" data-cc-track>
        {
          cards.map((c, i) => (
            <li
              class="cc__card"
              data-cc-card
              data-title={c.title}
              data-summary={c.summary}
              data-result={c.result}
              data-meta={c.meta}
              data-href={c.href}
            >
              <a href={c.href} class="cc__link">
                <div class:list={['cc__img', c.dark && 'cc__img--dark']}>
                  <img src={c.img} alt={c.alt} loading="eager" decoding="async" />
                  <span class="cc__over wide-type">{c.title}</span>
                  <span class="cc__open" aria-hidden="true">Open →</span>
                </div>
                <p class="cc__meta hud">
                  <b>{pad(i + 1)}</b> {c.meta}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="cc__info" aria-live="polite">
      <div class="cc__info-main" data-cc-info>
        <p class="hud" data-cc-meta>{cards[0].meta}</p>
        <p class="cc__title wide-type" data-cc-title>{cards[0].title}</p>
        <p class="cc__sum" data-cc-sum>{cards[0].summary}</p>
      </div>
      <p class="cc__result" data-cc-res-wrap>
        <span class="hud">result</span>
        <span data-cc-res>{cards[0].result}</span>
      </p>
      <div class="cc__go">
        <a class="pill" href={cards[0].href} data-cc-go>Open project →</a>
        <span class="cc__bar" aria-hidden="true"><i data-cc-bar></i></span>
      </div>
    </div>
  </div>
</section>

<style>
  .cc__stage {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    padding: 5.2rem 0 3.6rem;
  }

  /* Arkada yavaşça kayan dev kontur yazı */
  .cc__bg {
    position: absolute;
    left: 0;
    top: 50%;
    margin: 0;
    white-space: nowrap;
    font-size: clamp(6rem, 19vw, 20rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(13, 17, 22, .08);
    transform: translateY(-58%);
    pointer-events: none;
    will-change: transform;
  }

  .cc__head {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding: 0 clamp(1.2rem, 4vw, 3rem);
  }

  .cc__head .hud { margin: 0; white-space: nowrap; }

  .cc__count {
    white-space: nowrap;
    margin: .4rem 0 0;
    font-size: clamp(2.6rem, 6vw, 5.6rem);
    color: var(--paper-ink);
  }

  .cc__count small {
    font-size: .38em;
    color: #8a877f;
    letter-spacing: 0;
  }

  .cc__h { font-size: clamp(2rem, 5vw, 4.4rem); color: var(--paper-ink); text-align: right; }

  .cc__viewport {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .cc__track {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Her kart kendi perspektifini taşır; şerit tıklamaları yutmasın */
    pointer-events: none;
    will-change: transform;
  }

  .cc__card {
    flex: none;
    width: clamp(280px, min(46vw, 84vh), 900px);
    margin: 0;
    pointer-events: auto;
    will-change: transform;
  }

  .cc__link { display: block; border: 0; color: inherit; cursor: pointer; }

  .cc__open {
    position: absolute;
    top: .8rem;
    right: .8rem;
    padding: .4rem .8rem;
    border-radius: 999px;
    background: #f3efe7;
    color: #07090c;
    font-family: var(--font-mono);
    font-size: .7rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity .25s ease, transform .25s ease;
  }

  .cc__link:hover .cc__open,
  .cc__link:focus-visible .cc__open { opacity: 1; transform: none; }

  @media (hover: none) { .cc__open { opacity: 1; transform: none; } }

  .cc__img {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #fbfaf7;
    border: 1px solid rgba(13, 17, 22, .12);
    box-shadow: 0 40px 80px -36px rgba(13, 17, 22, .5);
  }

  .cc__img--dark { background: #07090c; border-color: #07090c; }

  .cc__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .cc__link:hover .cc__img img { transform: scale(1.04); }

  .cc__over {
    position: absolute;
    left: 1rem;
    bottom: .8rem;
    font-size: clamp(1.5rem, 3vw, 2.8rem);
    color: #fff;
    mix-blend-mode: difference;
  }

  .cc__meta { margin: .8rem 0 0; }

  /* Alt bilgi satırı */
  .cc__info {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto;
    gap: 1.4rem clamp(1.4rem, 4vw, 3.6rem);
    align-items: end;
    padding: 1.4rem clamp(1.2rem, 4vw, 3rem) 0;
    border-top: 1px solid rgba(13, 17, 22, .14);
    margin: 0 clamp(1.2rem, 4vw, 3rem);
    padding-left: 0;
    padding-right: 0;
  }

  .cc__info .hud { margin: 0 0 .3rem; }

  .cc__title {
    margin: 0 0 .4rem;
    font-size: clamp(1.4rem, 2.6vw, 2.4rem);
    color: var(--paper-ink);
  }

  .cc__sum { margin: 0; color: #4a4a46; font-size: .95rem; max-width: 52ch; }

  .cc__result {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--paper-ink);
    font-size: .9rem;
    line-height: 1.5;
  }

  .cc__result .hud { display: block; color: var(--accent); }

  .cc__go { display: grid; justify-items: end; gap: .8rem; }

  .cc__go .pill { background: var(--paper-ink); color: var(--paper); border-color: var(--paper-ink); }
  .cc__go .pill:hover, .cc__go .pill:focus-visible { background: transparent; color: var(--paper-ink); }

  .cc__bar { width: 180px; height: 2px; background: rgba(13, 17, 22, .12); }
  .cc__bar i { display: block; height: 100%; width: 0; background: var(--paper-ink); }

  @media (max-width: 900px) {
    .cc__info { grid-template-columns: minmax(0, 1fr) auto; }
    .cc__result { display: none; }
  }

  @media (max-width: 640px) {
    .cc__stage { padding-top: 7.4rem; }
    .cc__card { width: 80vw; }
    .cc__info { grid-template-columns: minmax(0, 1fr); }
    .cc__go { justify-items: start; }
    .cc__sum { font-size: .88rem; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-cc]')!;
  const track = root.querySelector<HTMLElement>('[data-cc-track]')!;
  const cards = [...root.querySelectorAll<HTMLElement>('[data-cc-card]')];
  const bg = root.querySelector<HTMLElement>('[data-cc-bg]')!;
  const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
  const info = $('[data-cc-info]');
  const nEl = $('[data-cc-n]'), metaEl = $('[data-cc-meta]'), titleEl = $('[data-cc-title]');
  const sumEl = $('[data-cc-sum]'), resEl = $('[data-cc-res]'), resWrap = $('[data-cc-res-wrap]');
  const go = root.querySelector<HTMLAnchorElement>('[data-cc-go]')!;
  const bar = $('[data-cc-bar]');

  let active = 0;
  function setActive(i: number) {
    if (i === active) return;
    active = i;
    const d = cards[i].dataset;
    nEl.textContent = String(i + 1).padStart(2, '0');
    metaEl.textContent = d.meta ?? '';
    titleEl.textContent = d.title ?? '';
    sumEl.textContent = d.summary ?? '';
    resEl.textContent = d.result ?? '';
    go.href = d.href ?? '#';
    gsap.fromTo([info, resWrap], { opacity: 0, filter: 'blur(8px)', y: 10 }, { opacity: 1, filter: 'blur(0px)', y: 0, duration: 0.45, ease: 'power2.out', overwrite: true });
  }

  function layout(p: number) {
    const vw = innerWidth;
    const cw = cards[0].offsetWidth;
    const gap = cw * 0.08;
    const total = cards.length * (cw + gap);
    // ilk kart merkezde başlar, son kart merkezde biter
    const start = vw / 2 - cw / 2;
    const end = vw / 2 - (total - gap) + cw / 2;
    const x = start + (end - start) * p;
    track.style.transform = `translateX(${x}px)`;
    let best = 0, bestD = Infinity;
    cards.forEach((c, i) => {
      const center = x + i * (cw + gap) + cw / 2;
      const d = (center - vw / 2) / (vw / 2); // -1 … 1 ekran kenarında
      const rot = Math.max(-62, Math.min(62, d * 38));
      const z = -Math.abs(d) * cw * 0.55;
      c.style.marginRight = `${gap}px`;
      c.style.transform = `perspective(1600px) translateZ(${z}px) rotateY(${-rot}deg)`;
      c.style.opacity = String(Math.max(0.25, 1 - Math.abs(d) * 0.35));
      if (Math.abs(d) < bestD) { bestD = Math.abs(d); best = i; }
    });
    setActive(best);
    bar.style.width = `${p * 100}%`;
    bg.style.transform = `translate(${-p * 30}%, -58%)`;
  }

  if (reduceMotion) {
    root.style.height = 'auto';
    track.style.flexWrap = 'wrap';
    track.style.gap = '1.4rem';
    track.style.padding = '0 1.2rem';
  } else {
    layout(0);
    ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: 'bottom bottom',
      scrub: true,
      onUpdate: (s) => layout(s.progress),
      onRefresh: (s) => layout(s.progress),
    });
  }
</script>
