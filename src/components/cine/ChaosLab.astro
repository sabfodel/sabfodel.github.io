---
/**
 * CHAOS — tam ekran tuhaf çekici. Birbirinden 10⁻⁶ uzakta başlayan iki nokta
 * (turuncu, camgöbeği) aynı denklemi RK4 ile izler. Kaydırdıkça ortada tek tek
 * kelimeler belirir; köşelerde denklemler, canlı değerler, ln|Δ| grafiği ve
 * ondan ölçülen Lyapunov üsteli, kontroller.
 */
const WORDS = ['Two', 'points.', 'Almost', 'the same', 'start.', 'Completely', 'different', 'paths.', 'Butterfly', 'effect.'];
---

<section class="ch pin" id="chaos" data-chaos aria-labelledby="ch-title">
  <div class="pin__stage ch__stage">
    <canvas class="ch__canvas" data-ch-canvas role="img" aria-label="Strange attractor with two diverging trajectories"></canvas>

    <header class="ch__top">
      <div>
        <p id="ch-title" class="spaced ch__brand">Chaos</p>
        <p class="hud">live · rk4 · drag to rotate</p>
      </div>
      <p class="ch__glyph" aria-hidden="true">χάος</p>
    </header>

    <p class="ch__word wide-type" data-ch-word aria-live="polite"></p>

    <div class="ch__sys">
      <p class="spaced ch__name" data-ch-name>Lorenz</p>
      <p class="hud" data-ch-year>1963</p>
      <pre class="ch__eq" data-ch-eq></pre>
      <p class="hud ch__params" data-ch-params></p>
      <div class="ch__live hud">
        <div><i class="sw sw--a"></i><b>A</b> <span data-ch-a></span></div>
        <div><i class="sw sw--b"></i><b>B</b> <span data-ch-b></span></div>
      </div>
    </div>

    <div class="ch__plot">
      <p class="hud">ln |Δ| vs t</p>
      <canvas data-ch-plot aria-hidden="true"></canvas>
      <p class="hud ch__lyap">|Δ| <b data-ch-d>1.0e-6</b> · λ ≈ <b data-ch-l>—</b></p>
    </div>

    <div class="ch__ctl">
      <div class="ch__btns" role="group" aria-label="System">
        <button type="button" class="chip is-on" data-sys="lorenz">Lorenz</button>
        <button type="button" class="chip" data-sys="yuwang">Yu-Wang</button>
        <button type="button" class="chip" data-sys="thomas">Thomas</button>
      </div>
      <div class="ch__sliders" data-ch-sliders></div>
      <div class="ch__btns">
        <button type="button" class="chip chip--accent" data-ch-perturb>Restart 10⁻⁶</button>
        <button type="button" class="chip" data-ch-sound aria-pressed="false">Sound off</button>
      </div>
    </div>

    <ol class="ch__words" hidden>{WORDS.map((w) => <li>{w}</li>)}</ol>
  </div>
</section>

<style>
  .ch { height: 360vh; background: #050608; }

  .ch__stage {
    background: radial-gradient(60% 60% at 50% 45%, rgba(57, 224, 196, .04), transparent 70%), #050608;
  }

  .ch__canvas { position: absolute; inset: 0; width: 100%; height: 100%; cursor: grab; touch-action: pan-y; }
  .ch__canvas:active { cursor: grabbing; }

  .ch__top {
    position: absolute;
    top: 5.2rem;
    left: clamp(1rem, 3vw, 2.2rem);
    right: clamp(1rem, 3vw, 2.2rem);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .ch__top p { margin: 0; }
  .ch__brand { font-size: .8rem; color: var(--ink); margin-bottom: .2rem !important; }
  .ch__glyph { font-family: var(--font-display); font-size: 1.1rem; color: var(--ink-dim); writing-mode: vertical-rl; }

  .ch__word {
    position: absolute;
    left: 0;
    right: 0;
    top: 58%;
    margin: 0;
    text-align: center;
    font-size: clamp(2.4rem, 7vw, 6.4rem);
    color: #fff;
    text-shadow: 0 0 30px rgba(0, 0, 0, .9), 0 0 60px rgba(0, 0, 0, .6);
    pointer-events: none;
  }

  .ch__sys, .ch__plot, .ch__ctl {
    position: absolute;
    bottom: 1.6rem;
    margin: 0;
  }

  .ch__sys { left: clamp(1rem, 3vw, 2.2rem); bottom: 3.6rem; max-width: 23rem; }
  .ch__plot { left: 50%; transform: translateX(-50%); width: 240px; }
  .ch__ctl { right: clamp(1rem, 3vw, 2.2rem); width: 18rem; display: grid; gap: .7rem; }

  .ch__name { font-size: 1rem; color: var(--ink); margin: 0 0 .2rem; }
  .ch__sys .hud { margin: 0; }

  .ch__eq {
    margin: .7rem 0 .4rem;
    padding: 0;
    border: 0;
    background: none !important;
    color: var(--ink);
    font-family: var(--font-display);
    font-style: italic;
    font-size: .98rem;
    line-height: 1.6;
    white-space: pre;
  }

  .ch__params { color: var(--ink-dim); }
  .ch__live { display: grid; gap: .2rem; margin-top: .6rem; font-variant-numeric: tabular-nums; }
  .ch__live b { color: var(--ink); }

  .sw { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: .4rem; }
  .sw--a { background: var(--glow-a); box-shadow: 0 0 8px var(--glow-a); }
  .sw--b { background: var(--glow-b); box-shadow: 0 0 8px var(--glow-b); }

  .ch__plot canvas { display: block; width: 240px; height: 96px; margin: .4rem 0; border-left: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); }
  .ch__plot .hud { margin: 0; }
  .ch__lyap b { color: var(--ink); }

  .ch__btns { display: flex; flex-wrap: wrap; gap: .4rem; }

  .chip {
    padding: .38rem .7rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: rgba(5, 6, 8, .6);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color .2s, color .2s, background .2s;
  }

  .chip:hover, .chip:focus-visible { color: var(--ink); border-color: var(--ink-dim); }
  .chip.is-on, .chip[aria-pressed='true'] { color: #07090c; background: var(--ink); border-color: var(--ink); }
  .chip--accent { color: var(--glow-a); border-color: rgba(255, 154, 77, .5); }

  .ch__sliders { display: grid; gap: .3rem; }

  .ch__sliders :global(label) {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr) 3.4rem;
    gap: .6rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--ink-dim);
  }

  .ch__sliders :global(output) { text-align: right; color: var(--ink); font-variant-numeric: tabular-nums; }

  .ch__sliders :global(input[type='range']) {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 2px;
    background: var(--line-2);
  }

  .ch__sliders :global(input[type='range']::-webkit-slider-thumb) {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink);
    cursor: pointer;
  }

  .ch__sliders :global(input[type='range']::-moz-range-thumb) {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    cursor: pointer;
  }

  @media (max-width: 1100px) {
    .ch__plot { display: none; }
  }

  @media (max-width: 760px) {
    .ch__top { top: 6.8rem; }
    .ch__word { top: 50%; }
    .ch__sys { bottom: 6.2rem; }
    .ch__eq, .ch__params { display: none; }
    .ch__ctl { left: clamp(1rem, 3vw, 2.2rem); right: auto; width: auto; bottom: 1.2rem; }
    .ch__sliders, .ch__ctl .ch__btns + .ch__btns { display: none; }
  }
</style>

<script>
  import { ScrollTrigger, fitCanvas, loop, reduceMotion, isSmall, clamp, gsap } from '../../scripts/motion';

  type Vec3 = [number, number, number];
  type Sys = {
    name: string;
    year: string;
    eq: string;
    params: { k: string; v: number; min: number; max: number; step: number }[];
    f: (s: Vec3, p: number[]) => Vec3;
    dt: number;
    steps: number;
    x0: Vec3;
  };

  const SYSTEMS: Record<string, Sys> = {
    lorenz: {
      name: 'Lorenz',
      year: 'Edward Lorenz · 1963',
      eq: 'ẋ = σ(y − x)\nẏ = x(ρ − z) − y\nż = xy − βz',
      params: [
        { k: 'σ', v: 10, min: 4, max: 20, step: 0.1 },
        { k: 'ρ', v: 28, min: 14, max: 50, step: 0.1 },
        { k: 'β', v: 8 / 3, min: 1, max: 4, step: 0.01 },
      ],
      f: ([x, y, z], [s, r, b]) => [s * (y - x), x * (r - z) - y, x * y - b * z],
      dt: 0.005,
      steps: 5,
      x0: [1, 1, 1],
    },
    yuwang: {
      name: 'Yu-Wang',
      year: 'Fei Yu & Chunhua Wang · 2012',
      eq: 'ẋ = a(y − x)\nẏ = bx − cxz\nż = eˣʸ − dz',
      params: [
        { k: 'a', v: 10, min: 6, max: 14, step: 0.1 },
        { k: 'b', v: 40, min: 30, max: 50, step: 0.1 },
        { k: 'c', v: 2, min: 1.2, max: 3, step: 0.01 },
        { k: 'd', v: 2.5, min: 1.8, max: 3.2, step: 0.01 },
      ],
      f: ([x, y, z], [a, b, c, d]) => [a * (y - x), b * x - c * x * z, Math.exp(x * y) - d * z],
      dt: 0.001,
      steps: 16,
      x0: [0.1, 0.1, 0.1],
    },
    thomas: {
      name: 'Thomas',
      year: 'René Thomas · 1999',
      eq: 'ẋ = sin y − bx\nẏ = sin z − by\nż = sin x − bz',
      params: [{ k: 'b', v: 0.208186, min: 0.16, max: 0.24, step: 0.0005 }],
      f: ([x, y, z], [b]) => [Math.sin(y) - b * x, Math.sin(z) - b * y, Math.sin(x) - b * z],
      dt: 0.04,
      steps: 4,
      x0: [0.1, 0, 0],
    },
  };

  function rk4(f: Sys['f'], s: Vec3, p: number[], h: number): Vec3 {
    const k1 = f(s, p);
    const k2 = f([s[0] + (h / 2) * k1[0], s[1] + (h / 2) * k1[1], s[2] + (h / 2) * k1[2]], p);
    const k3 = f([s[0] + (h / 2) * k2[0], s[1] + (h / 2) * k2[1], s[2] + (h / 2) * k2[2]], p);
    const k4 = f([s[0] + h * k3[0], s[1] + h * k3[1], s[2] + h * k3[2]], p);
    return [
      s[0] + (h / 6) * (k1[0] + 2 * k2[0] + 2 * k3[0] + k4[0]),
      s[1] + (h / 6) * (k1[1] + 2 * k2[1] + 2 * k3[1] + k4[1]),
      s[2] + (h / 6) * (k1[2] + 2 * k2[2] + 2 * k3[2] + k4[2]),
    ];
  }

  const root = document.querySelector<HTMLElement>('[data-chaos]')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-ch-canvas]')!;
  const plot = root.querySelector<HTMLCanvasElement>('[data-ch-plot]')!;
  const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
  const nameEl = $('[data-ch-name]'), yearEl = $('[data-ch-year]'), eqEl = $('[data-ch-eq]');
  const paramsEl = $('[data-ch-params]'), aEl = $('[data-ch-a]'), bEl = $('[data-ch-b]');
  const dEl = $('[data-ch-d]'), lEl = $('[data-ch-l]'), wordEl = $('[data-ch-word]');
  const sliders = $('[data-ch-sliders]');
  const soundBtn = root.querySelector<HTMLButtonElement>('[data-ch-sound]')!;
  const words = [...root.querySelectorAll('.ch__words li')].map((li) => li.textContent ?? '');

  let sys = SYSTEMS.lorenz;
  let params: number[] = [];
  let A: Vec3 = [1, 1, 1], B: Vec3 = [1, 1, 1], t = 0;
  let trailA: Vec3[] = [], trailB: Vec3[] = [];
  let ghost: Vec3[] = [];
  let lo: Vec3 = [0, 0, 0], hi: Vec3 = [1, 1, 1];
  let W = 0, H = 0, PW = 0, PH = 0;
  let yaw = 0.5, pitch = 0.2, userTurned = false;
  let series: [number, number][] = [];   // (t, ln|Δ|)
  let saturatedAt = -1;
  // Benettin yöntemi: A'nın yanında sürekli yeniden ölçeklenen gölge nokta C
  const D0 = 1e-8;
  let C: Vec3 = [1, 1, 1], lsum = 0, lT = 0, lsteps = 0;
  function resetLyap() {
    C = [A[0] + D0, A[1], A[2]];
    lsum = 0; lT = 0; lsteps = 0;
    lEl.textContent = '—';
  }
  const TRAIL = isSmall() ? 180 : 320;

  const ctx = fitCanvas(canvas, (w, h) => { W = w; H = h; });
  const pctx = fitCanvas(plot, (w, h) => { PW = w; PH = h; });

  // --- sistem ---------------------------------------------------------------
  function computeGhost() {
    let s: Vec3 = [...sys.x0];
    const pts: Vec3[] = [];
    const l: Vec3 = [Infinity, Infinity, Infinity], h: Vec3 = [-Infinity, -Infinity, -Infinity];
    for (let i = 0; i < 30000; i++) {
      s = rk4(sys.f, s, params, sys.dt * (sys.steps > 8 ? 2 : 1));
      if (!s.every(Number.isFinite)) break;
      if (i > 1500) {
        for (let k = 0; k < 3; k++) { l[k] = Math.min(l[k], s[k]); h[k] = Math.max(h[k], s[k]); }
        if (i % 3 === 0) pts.push(s);
      }
    }
    if (pts.length > 100) { ghost = pts; lo = l; hi = h; A = pts[pts.length - 1]; }
    else { ghost = []; A = [...sys.x0]; }
    resetLyap();
    seed();
  }

  function seed() {
    B = [A[0] + 1e-6, A[1], A[2]];
    trailA = []; trailB = []; t = 0;
    series = [];
    saturatedAt = -1;
  }

  function renderSliders() {
    sliders.replaceChildren(
      ...sys.params.map((p, i) => {
        const label = document.createElement('label');
        const span = document.createElement('span');
        span.textContent = p.k;
        const input = document.createElement('input');
        input.type = 'range';
        input.min = String(p.min); input.max = String(p.max); input.step = String(p.step);
        input.value = String(params[i]);
        input.setAttribute('aria-label', `Parameter ${p.k}`);
        const out = document.createElement('output');
        const fmtP = () => params[i].toFixed(p.step < 0.01 ? 4 : 2);
        out.textContent = fmtP();
        let timer = 0;
        input.addEventListener('input', () => {
          params[i] = Number(input.value);
          out.textContent = fmtP();
          writeParams();
          clearTimeout(timer);
          timer = window.setTimeout(computeGhost, 120);
        });
        label.append(span, input, out);
        return label;
      })
    );
  }

  function writeParams() {
    paramsEl.textContent = sys.params.map((p, i) => `${p.k} = ${params[i].toFixed(p.step < 0.01 ? 4 : 2)}`).join('   ');
  }

  function useSystem(key: string) {
    sys = SYSTEMS[key];
    params = sys.params.map((p) => p.v);
    nameEl.textContent = sys.name;
    yearEl.textContent = sys.year;
    eqEl.textContent = sys.eq;
    writeParams();
    renderSliders();
    computeGhost();
    root.querySelectorAll<HTMLButtonElement>('[data-sys]').forEach((b) => b.classList.toggle('is-on', b.dataset.sys === key));
  }

  root.querySelectorAll<HTMLButtonElement>('[data-sys]').forEach((b) => b.addEventListener('click', () => useSystem(b.dataset.sys!)));
  root.querySelector('[data-ch-perturb]')!.addEventListener('click', seed);

  // --- izdüşüm --------------------------------------------------------------
  function project(p: Vec3) {
    const nx = ((p[0] - lo[0]) / (hi[0] - lo[0] || 1)) * 2 - 1;
    const ny = ((p[1] - lo[1]) / (hi[1] - lo[1] || 1)) * 2 - 1;
    const nz = ((p[2] - lo[2]) / (hi[2] - lo[2] || 1)) * 2 - 1;
    const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
    const x1 = nx * cy - ny * sy;
    const y1 = nx * sy + ny * cy;
    const v = nz * cp - y1 * sp;
    const s = Math.min(W * 0.36, H * 0.34);
    return { x: W / 2 + x1 * s, y: H * 0.44 - v * s };
  }

  function drawTrail(trail: Vec3[], color: string) {
    ctx.strokeStyle = color;
    ctx.lineCap = 'round';
    for (let i = 1; i < trail.length; i++) {
      const a = project(trail[i - 1]), b = project(trail[i]);
      const k = i / trail.length;
      ctx.globalAlpha = k * k * 0.95;
      ctx.lineWidth = 0.6 + k * 2.2;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }

  function head(p: Vec3, color: string) {
    const q = project(p);
    const g = ctx.createRadialGradient(q.x, q.y, 0, q.x, q.y, 22);
    g.addColorStop(0, color);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(q.x, q.y, 22, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.arc(q.x, q.y, 2.4, 0, Math.PI * 2);
    ctx.fill();
  }

  const fmt = (v: number) => (v >= 0 ? ' ' : '−') + Math.abs(v).toFixed(2).padStart(5, ' ');

  // ln|Δ| grafiği; doğrusal büyüme bölgesinin eğimi en büyük Lyapunov üstelidir
  function drawPlot() {
    if (!PW) return;
    pctx.clearRect(0, 0, PW, PH);
    if (series.length < 2) return;
    const tMax = Math.max(20, series[series.length - 1][0]);
    const yMin = Math.log(1e-6) - 1, yMax = 4;
    pctx.strokeStyle = '#ff9a4d';
    pctx.lineWidth = 1.3;
    pctx.beginPath();
    series.forEach(([tt, y], i) => {
      const x = (tt / tMax) * PW, yy = PH - ((y - yMin) / (yMax - yMin)) * PH;
      if (i === 0) pctx.moveTo(x, yy);
      else pctx.lineTo(x, yy);
    });
    pctx.stroke();
  }

  function frame() {
    if (!W) return;
    for (let i = 0; i < sys.steps; i++) {
      A = rk4(sys.f, A, params, sys.dt);
      B = rk4(sys.f, B, params, sys.dt);
      C = rk4(sys.f, C, params, sys.dt);
      t += sys.dt;
      lT += sys.dt;
      if (++lsteps % 10 === 0) {
        const dc = Math.hypot(C[0] - A[0], C[1] - A[1], C[2] - A[2]) || D0;
        lsum += Math.log(dc / D0);
        C = [A[0] + ((C[0] - A[0]) * D0) / dc, A[1] + ((C[1] - A[1]) * D0) / dc, A[2] + ((C[2] - A[2]) * D0) / dc];
      }
    }
    if (!A.every(Number.isFinite) || !B.every(Number.isFinite) || !C.every(Number.isFinite)) { computeGhost(); return; }
    if (lT > 5) lEl.textContent = (lsum / lT).toFixed(2);
    trailA.push(A); trailB.push(B);
    if (trailA.length > TRAIL) { trailA.shift(); trailB.shift(); }
    if (!userTurned) yaw += 0.0016;

    const d = Math.hypot(A[0] - B[0], A[1] - B[1], A[2] - B[2]);
    if (d > 0) series.push([t, Math.log(d)]);
    const span = Math.hypot(hi[0] - lo[0], hi[1] - lo[1], hi[2] - lo[2]);
    if (saturatedAt < 0 && d > span * 0.3) saturatedAt = t;
    // ayrıştıktan bir süre sonra baştan başla
    if (saturatedAt > 0 && t - saturatedAt > 12 * (sys.dt * sys.steps * 60)) seed();

    ctx.clearRect(0, 0, W, H);
    ctx.strokeStyle = 'rgba(236,232,223,.14)';
    ctx.lineWidth = 0.6;
    ctx.beginPath();
    const stride = isSmall() ? 2 : 1;
    for (let i = 0; i < ghost.length; i += stride) {
      const q = project(ghost[i]);
      if (i === 0) ctx.moveTo(q.x, q.y);
      else ctx.lineTo(q.x, q.y);
    }
    ctx.stroke();

    ctx.globalCompositeOperation = 'lighter';
    drawTrail(trailB, '#39e0c4');
    drawTrail(trailA, '#ff9a4d');
    head(B, 'rgba(57,224,196,.9)');
    head(A, 'rgba(255,154,77,.9)');
    ctx.globalCompositeOperation = 'source-over';

    aEl.textContent = `x${fmt(A[0])}  y${fmt(A[1])}  z${fmt(A[2])}`;
    bEl.textContent = `x${fmt(B[0])}  y${fmt(B[1])}  z${fmt(B[2])}`;
    dEl.textContent = d.toExponential(1);
    drawPlot();
    sound(A, B);
  }

  // --- sürükleme ------------------------------------------------------------
  let drag: { x: number; y: number; yaw: number; pitch: number } | null = null;
  canvas.addEventListener('pointerdown', (e) => {
    drag = { x: e.clientX, y: e.clientY, yaw, pitch };
    userTurned = true;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!drag) return;
    yaw = drag.yaw - (e.clientX - drag.x) * 0.006;
    pitch = clamp(drag.pitch + (e.clientY - drag.y) * 0.006, -1.4, 1.4);
  });
  const end = () => (drag = null);
  canvas.addEventListener('pointerup', end);
  canvas.addEventListener('pointercancel', end);

  // --- ses: z → perde, x → stereo ------------------------------------------
  let audio: { ctx: AudioContext; oa: OscillatorNode; ob: OscillatorNode; pa: StereoPannerNode; pb: StereoPannerNode; g: GainNode } | null = null;
  let soundOn = false;

  function sound(a: Vec3, b: Vec3) {
    if (!audio || !soundOn) return;
    const now = audio.ctx.currentTime;
    const n = (v: number, k: number) => clamp((v - lo[k]) / (hi[k] - lo[k] || 1));
    audio.oa.frequency.setTargetAtTime(110 + n(a[2], 2) * 330, now, 0.05);
    audio.ob.frequency.setTargetAtTime(110 + n(b[2], 2) * 330, now, 0.05);
    audio.pa.pan.setTargetAtTime(n(a[0], 0) * 2 - 1, now, 0.08);
    audio.pb.pan.setTargetAtTime(n(b[0], 0) * 2 - 1, now, 0.08);
  }

  soundBtn.addEventListener('click', () => {
    if (!audio) {
      const ac = new AudioContext();
      const g = ac.createGain();
      g.gain.value = 0;
      const lp = ac.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = 1200;
      g.connect(lp).connect(ac.destination);
      const mk = (type: OscillatorType) => {
        const o = ac.createOscillator();
        o.type = type;
        const p = ac.createStereoPanner();
        o.connect(p).connect(g);
        o.start();
        return [o, p] as const;
      };
      const [oa, pa] = mk('triangle');
      const [ob, pb] = mk('sine');
      audio = { ctx: ac, oa, ob, pa, pb, g };
    }
    soundOn = !soundOn;
    audio.ctx.resume();
    audio.g.gain.setTargetAtTime(soundOn ? 0.06 : 0, audio.ctx.currentTime, 0.1);
    soundBtn.setAttribute('aria-pressed', String(soundOn));
    soundBtn.textContent = soundOn ? 'Sound on' : 'Sound off';
  });

  // --- kaydırma: ortadaki tek kelime ---------------------------------------
  let shownWord = -2;
  function setWord(i: number) {
    if (i === shownWord) return;
    shownWord = i;
    wordEl.textContent = i >= 0 ? words[i] : '';
    if (i >= 0) {
      gsap.fromTo(wordEl, { opacity: 0, filter: 'blur(12px)', scale: 1.06 }, { opacity: 1, filter: 'blur(0px)', scale: 1, duration: 0.35, ease: 'power2.out', overwrite: true });
    }
  }

  // --- başlangıç ------------------------------------------------------------
  useSystem('lorenz');

  if (reduceMotion) {
    root.style.height = 'auto';
    requestAnimationFrame(() => { for (let i = 0; i < TRAIL; i++) frame(); });
  } else {
    loop(canvas, frame);
    new IntersectionObserver(([e]) => {
      if (audio && soundOn) audio.g.gain.setTargetAtTime(e.isIntersecting ? 0.06 : 0, audio.ctx.currentTime, 0.2);
    }).observe(canvas);
    ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: 'bottom bottom',
      scrub: true,
      onUpdate: (s) => {
        // ilk %75'te kelimeler sırayla, sonra temiz ekran
        const k = s.progress < 0.04 || s.progress > 0.78 ? -1 : Math.min(words.length - 1, Math.floor(((s.progress - 0.04) / 0.74) * words.length));
        setWord(k);
      },
    });
    // bölüme girerken iki noktayı aynı yerden başlat ki ayrışma görülsün
    ScrollTrigger.create({ trigger: root, start: 'top 60%', onEnter: seed, onEnterBack: seed });
  }
</script>
