---
/**
 * WHERE I'VE BEEN — arkada kaydırmayla akan dev kontur yazılar; önde yolculuğun
 * durakları bulanık / RGB kaymalı geçişle birbirinin yerini alır.
 */
const STOPS = [
  { when: 'now', title: 'Physics student', body: 'Third year of a physics degree. Classes come first.' },
  { when: 'qiskit · qworld', title: 'Quantum computing', body: 'Finished the Qiskit Global Summer School. Now working through QWorld QBronze.' },
  { when: '05–07 · 2026', title: 'Simulations', body: 'qsim-rs, nbody-sim and gargantua-rs. Written in Rust, without physics libraries.' },
  { when: '07 · 2026', title: 'Pulsar search', body: 'Classified pulsar candidates from the HTRU2 survey. Recall 0.92.' },
  { when: 'next', title: 'Physics in medicine', body: 'Reading about medical physics and molecular simulation.' },
];
---

<section class="jr pin" data-journey data-sg style={`height:${STOPS.length * 80 + 60}vh`} aria-labelledby="jr-title">
  <div class="pin__stage jr__stage">
    <p class="jr__row jr__row--top wide-type" data-row="1" aria-hidden="true">Physics · Quantum · Simulation · Physics · Quantum · Simulation · Physics ·</p>
    <p class="jr__row jr__row--bot wide-type" data-row="-1" aria-hidden="true">Rust · Python · Qiskit · Rust · Python · Qiskit · Rust · Python · Qiskit ·</p>

    <div class="jr__grid">
      <h2 id="jr-title" class="jr__h wide-type">Where<br />I've been</h2>

      <div class="jr__stops" data-stops>
        {
          STOPS.map((s, i) => (
            <article class="jr__stop" data-stop aria-hidden={i === 0 ? undefined : 'true'}>
              <p class="hud">
                <b>{String(i + 1).padStart(2, '0')}</b> / {String(STOPS.length).padStart(2, '0')} · {s.when}
              </p>
              <h3 class="jr__title wide-type" data-text={s.title}>{s.title}</h3>
              <p class="jr__body">{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>

    <ol class="jr__dots" aria-hidden="true">
      {STOPS.map(() => <li data-dot></li>)}
    </ol>
  </div>
</section>

<style>
  .jr { background: rgba(7, 9, 12, .78); }

  .jr__stage { display: grid; align-items: center; }

  /* Kontur yazılar içeriğin arkasından değil, üst ve alt bantlardan akar */
  .jr__row {
    position: absolute;
    left: 0;
    margin: 0;
    white-space: nowrap;
    font-size: clamp(3rem, 9vw, 8rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(236, 232, 223, .1);
    pointer-events: none;
    will-change: transform;
  }

  .jr__row--top { top: 4.6rem; }
  .jr__row--bot { bottom: .6rem; -webkit-text-stroke-color: rgba(224, 138, 102, .14); }

  .jr__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding: 0 clamp(3rem, 7vw, 7rem) 0 clamp(1.2rem, 6vw, 6rem);
  }

  .jr__h {
    font-size: clamp(2.8rem, 7.6vw, 7rem);
    color: #f3efe7;
    text-shadow: 0 0 40px rgba(255, 255, 255, .18);
  }

  .jr__stops { position: relative; min-height: 15rem; }

  .jr__stop {
    position: absolute;
    inset: 0 0 auto 0;
    opacity: 0;
    filter: blur(16px);
    pointer-events: none;
  }

  .jr__stop.is-on { opacity: 1; filter: none; pointer-events: auto; }

  .jr__title {
    position: relative;
    margin: .5rem 0 1rem;
    font-size: clamp(1.8rem, 3.7vw, 3.5rem);
    color: #f3efe7;
  }

  /* RGB kayması: geçişte kısa süre titrer */
  .jr__title::before,
  .jr__title::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    mix-blend-mode: screen;
  }

  .jr__title::before { color: #ff3d6e; }
  .jr__title::after { color: #39e0c4; }

  .jr__stop.is-glitch .jr__title::before { animation: glitch-a .5s steps(2) both; }
  .jr__stop.is-glitch .jr__title::after { animation: glitch-b .5s steps(2) both; }

  @keyframes glitch-a {
    0% { opacity: .9; transform: translate(-6px, 2px); clip-path: inset(0 0 55% 0); }
    40% { opacity: .9; transform: translate(4px, -2px); clip-path: inset(40% 0 20% 0); }
    100% { opacity: 0; transform: none; }
  }

  @keyframes glitch-b {
    0% { opacity: .9; transform: translate(6px, -1px); clip-path: inset(50% 0 0 0); }
    40% { opacity: .9; transform: translate(-3px, 2px); clip-path: inset(10% 0 60% 0); }
    100% { opacity: 0; transform: none; }
  }

  .jr__body { max-width: 44ch; color: var(--ink-dim); margin: 0; }

  .jr__dots {
    position: absolute;
    right: clamp(1rem, 3vw, 2.2rem);
    top: 50%;
    display: grid;
    gap: .6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateY(-50%);
  }

  .jr__dots li {
    width: 6px;
    height: 6px;
    margin: 0;
    border: 1px solid var(--ink-faint);
    border-radius: 50%;
    transition: background .3s ease, transform .3s ease;
  }

  .jr__dots li.is-on { background: var(--glow-a); border-color: var(--glow-a); transform: scale(1.4); }

  @media (max-width: 1100px) {
    .jr__grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; align-content: center; }
    .jr__h br { display: none; }
    .jr__h { font-size: clamp(2.4rem, 8vw, 5rem); }
    .jr__stops { min-height: 13rem; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-journey]')!;
  const stops = [...root.querySelectorAll<HTMLElement>('[data-stop]')];
  const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
  const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];

  let current = -1;
  function show(i: number) {
    if (i === current) return;
    const prev = stops[current];
    current = i;
    dots.forEach((d, k) => d.classList.toggle('is-on', k === i));
    // Hızlı kaydırmada yarım kalmış geçişler üst üste binmesin
    gsap.killTweensOf(stops);
    stops.forEach((s, k) => {
      s.setAttribute('aria-hidden', k === i ? 'false' : 'true');
      if (k !== i && s !== prev) {
        s.classList.remove('is-on');
        gsap.set(s, { opacity: 0, filter: 'blur(16px)', y: 0 });
      }
    });
    if (prev) {
      gsap.to(prev, {
        opacity: 0,
        filter: 'blur(16px)',
        y: -24,
        duration: 0.3,
        ease: 'power2.in',
        onComplete: () => prev.classList.remove('is-on'),
      });
    }
    const next = stops[i];
    next.classList.add('is-on');
    next.classList.remove('is-glitch');
    void next.offsetWidth;
    next.classList.add('is-glitch');
    gsap.fromTo(
      next,
      { opacity: 0, filter: 'blur(16px)', y: 30 },
      { opacity: 1, filter: 'blur(0px)', y: 0, duration: 0.6, ease: 'power3.out', delay: prev ? 0.22 : 0 }
    );
  }

  if (reduceMotion) {
    root.style.height = 'auto';
    stops.forEach((s) => {
      s.style.position = 'static';
      s.classList.add('is-on');
      s.style.marginBottom = '2rem';
    });
  } else {
    show(0);
    ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: 'bottom bottom',
      scrub: true,
      onUpdate: (s) => {
        show(Math.min(stops.length - 1, Math.floor(s.progress * stops.length * 0.999)));
        rows.forEach((r) => {
          const dir = Number(r.dataset.row);
          r.style.transform = `translateX(${dir > 0 ? -s.progress * 40 : -40 + s.progress * 40}%)`;
        });
      },
    });
  }
</script>
