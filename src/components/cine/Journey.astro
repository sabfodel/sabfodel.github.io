---
/**
 * WHERE I'VE BEEN — arkada kaydırmayla akan dev kontur yazılar; önde yolculuğun
 * durakları bulanık / RGB kaymalı geçişle birbirinin yerini alır.
 */
const STOPS = [
  {
    when: 'now',
    title: 'Physics undergraduate',
    body: 'Third year of a physics degree. The coursework comes first — everything below grows out of it.',
  },
  {
    when: 'qiskit · qworld',
    title: 'Quantum apprentice',
    body: 'Completed the Qiskit Global Summer School. Working through QWorld’s QBronze track, rewriting every notebook in my own words.',
  },
  {
    when: '05 → 07 · 2026',
    title: 'Simulation builder',
    body: 'qsim-rs, nbody-sim, gargantua-rs — a quantum circuit simulator, a solar system and a black hole, all from first principles in Rust.',
  },
  {
    when: '07 · 2026',
    title: 'Signal hunter',
    body: 'Finding pulsars in radio-telescope noise on HTRU2: recall 0.92 on data that is 91% interference.',
  },
  {
    when: 'next',
    title: 'Physics × medicine',
    body: 'Reading into molecular simulation, medical physics and imaging — where quantum and computational physics meet the life sciences.',
  },
];
---

<section class="jr pin" data-journey style={`height:${STOPS.length * 80 + 60}vh`} aria-labelledby="jr-title">
  <div class="pin__stage jr__stage">
    <div class="jr__marquee" aria-hidden="true">
      <p class="jr__row wide-type" data-row="1">Computational physics · Quantum computing · First principles · Computational physics · Quantum computing ·</p>
      <p class="jr__row jr__row--b wide-type" data-row="-1">2026 · Rust · Python · Qiskit · Numerics · 2026 · Rust · Python · Qiskit · Numerics ·</p>
      <p class="jr__row wide-type" data-row="1">Simulation · Chaos · Black holes · Pulsars · Qubits · Simulation · Chaos · Black holes ·</p>
    </div>

    <div class="jr__grid">
      <h2 id="jr-title" class="jr__h wide-type">Where<br />I've been</h2>

      <div class="jr__stops" data-stops>
        {
          STOPS.map((s, i) => (
            <article class="jr__stop" data-stop aria-hidden={i === 0 ? undefined : 'true'}>
              <p class="hud">
                <b>{String(i + 1).padStart(2, '0')}</b> / {String(STOPS.length).padStart(2, '0')} · {s.when}
              </p>
              <h3 class="jr__title wide-type" data-text={s.title}>{s.title}</h3>
              <p class="jr__body">{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>

    <ol class="jr__dots" aria-hidden="true">
      {STOPS.map(() => <li data-dot></li>)}
    </ol>
  </div>
</section>

<style>
  .jr { background: #07090c; }

  .jr__stage { display: grid; align-items: center; }

  .jr__marquee {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: 1.2vh;
    pointer-events: none;
  }

  .jr__row {
    white-space: nowrap;
    font-size: clamp(4rem, 12vw, 11rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(236, 232, 223, .09);
    will-change: transform;
  }

  .jr__row--b { -webkit-text-stroke-color: rgba(224, 138, 102, .12); }

  .jr__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: 3rem;
    align-items: center;
    padding: 0 clamp(1.2rem, 6vw, 6rem);
  }

  .jr__h {
    font-size: clamp(2.8rem, 7.6vw, 7rem);
    color: #f3efe7;
    text-shadow: 0 0 40px rgba(255, 255, 255, .18);
  }

  .jr__stops { position: relative; min-height: 18rem; }

  .jr__stop {
    position: absolute;
    inset: 0 0 auto 0;
    opacity: 0;
    filter: blur(16px);
    pointer-events: none;
  }

  .jr__stop.is-on { opacity: 1; filter: none; pointer-events: auto; }

  .jr__title {
    position: relative;
    margin: .5rem 0 1rem;
    font-size: clamp(1.8rem, 3.7vw, 3.5rem);
    color: #f3efe7;
  }

  /* RGB kayması: geçişte kısa süre titrer */
  .jr__title::before,
  .jr__title::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    opacity: 0;
    mix-blend-mode: screen;
  }

  .jr__title::before { color: #ff3d6e; }
  .jr__title::after { color: #39e0c4; }

  .jr__stop.is-glitch .jr__title::before { animation: glitch-a .5s steps(2) both; }
  .jr__stop.is-glitch .jr__title::after { animation: glitch-b .5s steps(2) both; }

  @keyframes glitch-a {
    0% { opacity: .9; transform: translate(-6px, 2px); clip-path: inset(0 0 55% 0); }
    40% { opacity: .9; transform: translate(4px, -2px); clip-path: inset(40% 0 20% 0); }
    100% { opacity: 0; transform: none; }
  }

  @keyframes glitch-b {
    0% { opacity: .9; transform: translate(6px, -1px); clip-path: inset(50% 0 0 0); }
    40% { opacity: .9; transform: translate(-3px, 2px); clip-path: inset(10% 0 60% 0); }
    100% { opacity: 0; transform: none; }
  }

  .jr__body { max-width: 44ch; color: var(--ink-dim); margin: 0; }

  .jr__dots {
    position: absolute;
    right: clamp(1rem, 3vw, 2.2rem);
    top: 50%;
    display: grid;
    gap: .6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateY(-50%);
  }

  .jr__dots li {
    width: 6px;
    height: 6px;
    margin: 0;
    border: 1px solid var(--ink-faint);
    border-radius: 50%;
    transition: background .3s ease, transform .3s ease;
  }

  .jr__dots li.is-on { background: var(--glow-a); border-color: var(--glow-a); transform: scale(1.4); }

  @media (max-width: 760px) {
    .jr__grid { grid-template-columns: minmax(0, 1fr); gap: 1.4rem; align-content: center; }
    .jr__stops { min-height: 16rem; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduceMotion } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-journey]')!;
  const stops = [...root.querySelectorAll<HTMLElement>('[data-stop]')];
  const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
  const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];

  let current = -1;
  function show(i: number) {
    if (i === current) return;
    const prev = stops[current];
    current = i;
    stops.forEach((s, k) => s.setAttribute('aria-hidden', k === i ? 'false' : 'true'));
    dots.forEach((d, k) => d.classList.toggle('is-on', k === i));
    if (prev) {
      gsap.to(prev, { opacity: 0, filter: 'blur(16px)', y: -24, duration: 0.45, ease: 'power2.in', onComplete: () => prev.classList.remove('is-on') });
    }
    const next = stops[i];
    next.classList.add('is-on');
    next.classList.remove('is-glitch');
    void next.offsetWidth;
    next.classList.add('is-glitch');
    gsap.fromTo(next, { opacity: 0, filter: 'blur(16px)', y: 30 }, { opacity: 1, filter: 'blur(0px)', y: 0, duration: 0.7, ease: 'power3.out', delay: prev ? 0.15 : 0 });
  }

  if (reduceMotion) {
    root.style.height = 'auto';
    stops.forEach((s) => {
      s.style.position = 'static';
      s.classList.add('is-on');
      s.style.marginBottom = '2rem';
    });
  } else {
    show(0);
    ScrollTrigger.create({
      trigger: root,
      start: 'top top',
      end: 'bottom bottom',
      scrub: true,
      onUpdate: (s) => {
        show(Math.min(stops.length - 1, Math.floor(s.progress * stops.length * 0.999)));
        rows.forEach((r, k) => {
          const dir = Number(r.dataset.row);
          r.style.transform = `translateX(${(dir > 0 ? -1 : 1) * (s.progress * 45 + k * 6)}%)`;
        });
      },
    });
  }
</script>
