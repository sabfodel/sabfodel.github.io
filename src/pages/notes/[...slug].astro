---
import { getCollection, render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';

export const getStaticPaths = async () => {
  const notes = await getCollection('notes', (n) => !n.data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
};

const { note } = Astro.props;
const { Content } = await render(note);
---

<Entry
  title={note.data.title}
  kicker={note.data.field ? `note · ${note.data.field}` : 'note'}
  date={note.data.date}
  summary={note.data.summary}
  tags={note.data.tags}
  backHref="/notes/"
  backLabel="all notes"
>
  <Content />
</Entry>
