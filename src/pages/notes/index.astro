---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import EntryList from '../../components/EntryList.astro';
import { byDateDesc } from '../../utils';

const notes = (await getCollection('notes', (n) => !n.data.draft)).sort(byDateDesc);

const fields = new Map<string, typeof notes>();
for (const n of notes) {
  const f = n.data.field ?? 'other';
  if (!fields.has(f)) fields.set(f, []);
  fields.get(f)!.push(n);
}
const fieldNames = [...fields.keys()].sort();
---

<Base
  title="notes"
  description="Physics notes and derivations — condensed matter and quantum information."
>
  <Panel title="notes" note={`${notes.length} entries`}>
    <p style="margin-top:0" class="muted">
      Study notes, written up properly. Derivations, the intuition behind them, and the
      places I got stuck. If you spot a mistake I'd genuinely like to hear about it.
    </p>
    <p style="margin-bottom:0" class="muted">
      Equations are typeset with KaTeX: <code>$...$</code> inline, <code>$$...$$</code> for
      display.
    </p>
  </Panel>

  {
    fieldNames.map((f) => (
      <Panel title={f} note={`${fields.get(f)!.length} entries`}>
        <EntryList
          items={fields.get(f)!.map((n) => ({
            href: `/notes/${n.id}/`,
            title: n.data.title,
            date: n.data.date,
            summary: n.data.summary,
            tags: n.data.tags,
          }))}
        />
      </Panel>
    ))
  }

  {notes.length === 0 && <p class="empty">Nothing written up yet.</p>}
</Base>
