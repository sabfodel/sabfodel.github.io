---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import { SITE } from '../site';
---

<Base title="about" description="About this site.">
  <Panel title="about">
    <div class="prose">
      {/* Kendini anlatan bölüm buraya. Kim olduğun, ne okuduğun, ne ilgilendiğin. */}

      <h2>What's here</h2>
      <ul>
        <li><a href="/notes/">notes</a> — physics, written up properly</li>
        <li><a href="/projects/">projects</a> — things I've built</li>
        <li><a href="/reading/">reading</a> — books, with reviews</li>
        <li><a href="/practice/">practice</a> — what I'm learning outside physics</li>
        <li><a href="/photos/">photos</a> — frames I liked enough to keep</li>
        <li><a href="/journal/">journal</a> — everything that doesn't fit the others</li>
        <li><a href="/uses/">uses</a> — the desk, the machine, the software</li>
      </ul>

      <h2>This site</h2>
      <p>
        Built with Astro. No template, no cookies, no tracking, no ads. Posts are plain
        Markdown files; equations are typeset with KaTeX. There's an
        <a href="/rss.xml">RSS feed</a>.
      </p>

      <h2>Elsewhere</h2>
      <p>
        <a href={SITE.github}>github/sabfodel</a> ·
        <a href={SITE.instagram}>instagram/{SITE.instagramHandle.replace('@', '')}</a>
      </p>
    </div>
  </Panel>
</Base>
