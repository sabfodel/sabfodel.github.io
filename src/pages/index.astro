---
import Base from '../layouts/Base.astro';
import Preloader from '../components/cine/Preloader.astro';
import HeroGather from '../components/cine/HeroGather.astro';
import AboutZoom from '../components/cine/AboutZoom.astro';
import Journey from '../components/cine/Journey.astro';
import CurvedCarousel from '../components/cine/CurvedCarousel.astro';
import WorksRing from '../components/cine/WorksRing.astro';
import ChaosLab from '../components/cine/ChaosLab.astro';
import Capabilities from '../components/cine/Capabilities.astro';
import LetsTalk from '../components/cine/LetsTalk.astro';
---

<Base cinematic>
  <Preloader />

  <div data-hud-name="gather"><HeroGather /></div>
  <div data-hud-name="about"><AboutZoom /></div>
  <div data-hud-name="journey"><Journey /></div>
  <div data-hud-name="featured"><CurvedCarousel /></div>
  <div data-hud-name="works ’26"><WorksRing /></div>
  <div data-hud-name="chaos"><ChaosLab /></div>
  <div data-hud-name="skills"><Capabilities /></div>
  <div data-hud-name="contact"><LetsTalk /></div>

  <div class="scroll-hud" aria-hidden="true">
    <span class="hud" data-hud-sec>gather</span>
    <span class="scroll-hud__bar"><i data-hud-bar></i></span>
    <span class="hud" data-hud-pct>000</span>
  </div>
</Base>

<script>
  import { initMotion, ScrollTrigger } from '../scripts/motion';

  initMotion();

  // Sol alttaki kaydırma göstergesi: bölüm adı + ilerleme
  const sec = document.querySelector<HTMLElement>('[data-hud-sec]')!;
  const bar = document.querySelector<HTMLElement>('[data-hud-bar]')!;
  const pct = document.querySelector<HTMLElement>('[data-hud-pct]')!;
  const hud = document.querySelector<HTMLElement>('.scroll-hud')!;

  ScrollTrigger.create({
    start: 0,
    end: 'max',
    onUpdate: (s) => {
      bar.style.width = `${s.progress * 100}%`;
      pct.textContent = String(Math.round(s.progress * 100)).padStart(3, '0');
      // en altta alt bilgiyle çakışmasın
      hud.style.opacity = s.progress > 0.97 ? '0' : '1';
    },
  });

  document.querySelectorAll<HTMLElement>('[data-hud-name]').forEach((el) =>
    ScrollTrigger.create({
      trigger: el,
      start: 'top 50%',
      end: 'bottom 50%',
      onToggle: (s) => s.isActive && (sec.textContent = el.dataset.hudName!),
    })
  );

  // Görseller / fontlar yüklenince ölçüler değişir
  addEventListener('load', () => ScrollTrigger.refresh());
  document.fonts?.ready.then(() => ScrollTrigger.refresh());
</script>
