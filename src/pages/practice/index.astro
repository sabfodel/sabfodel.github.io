---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import EntryList from '../../components/EntryList.astro';
import { byDateDesc } from '../../utils';

const entries = (await getCollection('practice', (e) => !e.data.draft)).sort(byDateDesc);

const groups = new Map<string, typeof entries>();
for (const e of entries) {
  const d = e.data.discipline;
  if (!groups.has(d)) groups.set(d, []);
  groups.get(d)!.push(e);
}
const disciplines = [...groups.keys()].sort();
---

<Base title="practice" description="Things I'm learning outside physics — violin, and whatever comes next.">
  <Panel title="practice" note={`${entries.length} entries`}>
    <p style="margin:0" class="muted">
      A log of things I'm learning that aren't physics. What I worked on, what refused to
      cooperate, and the occasional small victory. Mostly for my own accountability — it's
      much harder to skip a week when the gap is visible.
    </p>
  </Panel>

  {
    disciplines.map((d) => (
      <Panel title={d} note={`${groups.get(d)!.length} entries`}>
        <EntryList
          items={groups.get(d)!.map((e) => ({
            href: `/practice/${e.id}/`,
            title: e.data.title,
            date: e.data.date,
            summary: e.data.summary,
            tags: e.data.tags,
          }))}
        />
      </Panel>
    ))
  }

  {entries.length === 0 && <Panel title="empty"><p class="empty">Nothing logged yet.</p></Panel>}
</Base>
