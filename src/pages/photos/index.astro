---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import Gallery from '../../components/Gallery.astro';
import { byOrderThenDate } from '../../utils';
import { SITE } from '../../site';

const photos = (await getCollection('photos', (p) => !p.data.draft)).sort(byOrderThenDate);
---

<Base title="photos" description="Photographs.">
  <Panel title="photos" note={`${photos.length} frames`}>
    <p style="margin:0" class="muted">
      More of these on Instagram — <a href={SITE.instagram}>{SITE.instagramHandle}</a>.
    </p>
  </Panel>

  <Panel title="gallery" note="◈ ◈ ◈">
    <Gallery
      photos={photos}
      empty="No photographs here yet. Drop a file into public/img/photos/ and add a .md file to src/content/photos/."
    />
  </Panel>
</Base>
