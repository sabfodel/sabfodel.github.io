---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import { formatDate } from '../utils';

const page = await getEntry('pages', 'uses');
if (!page) throw new Error('src/content/pages/uses.md is missing');
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.summary}>
  <Panel title={page.data.title}>
    {
      page.data.updated && (
        <p class="entry__meta" style="margin:0 0 1rem">
          <span>last updated {formatDate(page.data.updated)}</span>
        </p>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </Panel>
</Base>
