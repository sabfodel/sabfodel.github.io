---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import { byDateDesc, STATUS, tagsWithoutLang } from '../../utils';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.order - a.data.order || byDateDesc(a, b)
);
---

<Base title="projects" description="Things I build: simulators, tools, experiments." wide>
  <Panel title="projects" note={`${projects.length} entries`}>
    <p style="margin:0" class="muted">
      Mostly Rust, some Python. Every one of them started with the same question — "what
      would I learn if I wrote this myself?" Source is on GitHub.
    </p>
  </Panel>

  <Panel title="all of them">
    {
      projects.length === 0 ? (
        <p class="empty">No projects yet.</p>
      ) : (
        <ul class="grid-cards">
          {projects.map((p) => (
            <li class="card">
              <h3 class="card__title"><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
              <p class="card__sum">{p.data.summary}</p>
              <ul class="tags">
                <li class="tag">{STATUS[p.data.status]}</li>
                {p.data.lang && <li class="tag">{p.data.lang}</li>}
                {tagsWithoutLang(p.data.tags, p.data.lang)
                  .slice(0, 3)
                  .map((t) => <li class="tag">{t}</li>)}
              </ul>
              {p.data.repo && (
                <p style="margin:.6rem 0 0;font-size:.85rem">
                  <a href={p.data.repo}>source →</a>
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </Panel>
</Base>
