---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkItem from '../../components/WorkItem.astro';
import { byDateDesc, STATUS, tagsWithoutLang } from '../../utils';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.order - a.data.order || byDateDesc(a, b)
);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<Base title="work" description="Simulators, analyses and experiments — each with its method, results and limitations." wide>
  <header class="entry-head">
    <span class="kicker">work · {projects.length} projects</span>
    <h1>Things I've built to understand</h1>
    <p class="lede" style="margin:0">
      Each one started with the same question: what would I learn if I wrote this myself? Every
      write-up shows the physics, the method, what came out — and where it stops being right.
    </p>
  </header>

  <ol class="works">
    {featured.map((p, i) => <WorkItem project={p} n={i + 1} />)}
  </ol>

  {
    rest.length > 0 && (
      <section class="panel" style="margin-top:3rem">
        <header class="section-hd">
          <span class="label">§</span>
          <h2>Smaller things</h2>
          <span class="label">side projects</span>
        </header>
        <ul class="grid-cards">
          {rest.map((p) => (
            <li class="card">
              <h3 class="card__title"><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
              <p class="card__sum">{p.data.summary}</p>
              <ul class="tags">
                <li class="tag tag--status">{STATUS[p.data.status]}</li>
                {p.data.lang && <li class="tag">{p.data.lang}</li>}
                {tagsWithoutLang(p.data.tags, p.data.lang)
                  .slice(0, 2)
                  .map((t) => <li class="tag">{t}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
