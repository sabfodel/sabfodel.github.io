---
import { getCollection, render } from 'astro:content';
import Entry from '../../layouts/Entry.astro';
import { STATUS } from '../../utils';

export const getStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
};

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Entry
  title={d.title}
  kicker={`project · ${STATUS[d.status]}${d.lang ? ` · ${d.lang}` : ''}`}
  date={d.date}
  summary={d.summary}
  tags={d.tags}
  backHref="/projects/"
  backLabel="all work"
>
  {
    d.cover && (
      <figure style="margin:0 0 2rem">
        <div class:list={['plate', d.coverDark && 'plate--dark']}>
          <img src={d.cover} alt={d.coverAlt ?? ''} decoding="async" />
        </div>
        {d.caption && (
          <figcaption class="figcap">
            <span class="label">Fig. 1</span>
            <span>{d.caption}</span>
          </figcaption>
        )}
      </figure>
    )
  }
  {
    d.result && (
      <p class="result">
        <span class="label">result</span>
        {d.result}
      </p>
    )
  }
  {d.repo && <p class="work__links"><a href={d.repo}>source ↗ {d.repo.replace('https://github.com/', '')}</a></p>}
  <Content />
</Entry>
