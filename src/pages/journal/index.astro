---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Panel from '../../components/Panel.astro';
import EntryList from '../../components/EntryList.astro';
import { byDateDesc } from '../../utils';

const posts = (await getCollection('journal', (p) => !p.data.draft)).sort(byDateDesc);

const groups = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(p);
}
const years = [...groups.keys()].sort((a, b) => b - a);
---

<Base title="journal" description="Free-form writing: half-formed thoughts, notes to self.">
  <Panel title="journal" note={`${posts.length} entries`}>
    <p style="margin-top:0" class="muted">
      Chronological and unfiltered. The stuff that doesn't belong in a proper note —
      what I'm chewing on, where the code went wrong, the occasional late-night thought.
    </p>
    {posts.length === 0 && <p class="empty">Nothing written yet.</p>}
  </Panel>

  {
    years.map((year) => (
      <Panel title={String(year)} note={`${groups.get(year)!.length} entries`}>
        <EntryList
          items={groups.get(year)!.map((p) => ({
            href: `/journal/${p.id}/`,
            title: p.data.title,
            date: p.data.date,
            summary: p.data.summary,
            tags: p.data.tags,
            extra: p.data.mood ? `mood: ${p.data.mood}` : undefined,
          }))}
        />
      </Panel>
    ))
  }
</Base>
